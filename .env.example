# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Database
# For local MVP mode this can be omitted; the app will use data/app-db.json.
# On Render set DATABASE_URL to a managed PostgreSQL connection string.
DATABASE_URL=
DATABASE_SSL=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. If omitted, the app uses APP_URL + /api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Telegram, optional
BOT_TOKEN=
