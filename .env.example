HOST=0.0.0.0
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Обязателен в production. Используется для подписи cookie-сессий.
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL. Без переменной локально используется JSON-файл, но в production необходима постоянная БД.
DATABASE_URL=
DATABASE_SSL=true

# Первый администратор и дополнительные администраторы через запятую.
# Зарегистрируйте аккаунт с этим email и перезапустите приложение.
ADMIN_EMAILS=admin@example.com

# Необязательные интеграции авторизации.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Telegram-бот, необязательно.
BOT_TOKEN=

# Загрузка медицинских фотографий включается только после подключения защищённого хранилища.
PHOTO_STORAGE_PROVIDER=
PHOTO_STORAGE_BUCKET=
PHOTO_STORAGE_ENDPOINT=
PHOTO_STORAGE_ACCESS_KEY=
PHOTO_STORAGE_SECRET_KEY=
